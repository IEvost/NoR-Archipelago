<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Game.References.props" />

  <PropertyGroup>
    <AssemblyName>NoR.Archipelago</AssemblyName>
    <RootNamespace>NoR.Archipelago</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoR.Core\NoR.Core.csproj" />
    <ProjectReference Include="..\NoR.Randomizer\NoR.Randomizer.csproj" Private="false" />
    <Reference Include="Rewired_Core"><HintPath>$(GameManaged)\Rewired_Core.dll</HintPath><Private>false</Private></Reference>
    <!-- net35 build bundles websocket-sharp and Newtonsoft.Json; all three are copied next to the plugin. -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Location/item id map generated by tools/NoR.ApWorldGen. -->
    <EmbeddedResource Include="..\..\data\runtime\ap_map.tsv" LogicalName="NoR.Archipelago.ap_map.tsv" />
  </ItemGroup>

  <ItemGroup>
    <DeployExtra Include="$(OutDir)NoR.Core.dll" />
    <DeployExtra Include="$(OutDir)Archipelago.MultiClient.Net.dll" />
    <DeployExtra Include="$(OutDir)websocket-sharp.dll" />
    <DeployExtra Include="$(OutDir)Newtonsoft.Json.dll" />
    <!-- TLS bridge (published by: dotnet publish tools/NoR.ApBridge -c Release -o .tools/bridge-publish) -->
    <DeployExtra Include="..\..\.tools\bridge-publish\NoR.ApBridge.exe" Condition="Exists('..\..\.tools\bridge-publish\NoR.ApBridge.exe')" />
  </ItemGroup>
</Project>
