<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Game.References.props" />

  <PropertyGroup>
    <AssemblyName>NoR.Randomizer</AssemblyName>
    <RootNamespace>NoR.Randomizer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoR.Core\NoR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Rewired_Core"><HintPath>$(GameManaged)\Rewired_Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Location table generated by tools/NoR.DataBuilder. -->
    <EmbeddedResource Include="..\..\data\runtime\locations.tsv" LogicalName="NoR.Randomizer.locations.tsv" />
    <EmbeddedResource Include="..\..\data\runtime\enemies.tsv" LogicalName="NoR.Randomizer.enemies.tsv" />
    <EmbeddedResource Include="..\..\data\code_locations.tsv" LogicalName="NoR.Randomizer.code_locations.tsv" />
    <EmbeddedResource Include="..\..\data\shop_pool.txt" LogicalName="NoR.Randomizer.shop_pool.txt" />
  </ItemGroup>

  <ItemGroup>
    <DeployExtra Include="$(OutDir)NoR.Core.dll" />
  </ItemGroup>
</Project>
